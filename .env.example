# =============================================================================
# Cortex Farm — configuration template. Copy to .env and fill in.
# NEVER commit .env. Trading keys must be TRADE-ONLY (no withdrawal permission).
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# --- Mode: shadow (default, no money) | live (requires explicit opt-in + 2FA in the dashboard)
TRADING_MODE=shadow

# --- Databases (one per mode; see infra/compose.yaml). Shadow workers write farm_shadow; the live
# worker writes farm_live (fills, orders, ledger, treasury, withdrawals). Both are derived from
# the recordings and can be rebuilt with persist-backfill. PERSIST_ENABLED=false turns it off.
DATABASE_URL=postgresql://cortex:cortex_dev_only@localhost:5432/farm_shadow
REDIS_URL=redis://localhost:6379
POSTGRES_PASSWORD=cortex_dev_only

# --- Worker: which market to make (MEXC execution, Binance reference)
BOT_VENUE=mexc
BOT_SYMBOL=SOLUSDT
BOT_REFERENCE_SYMBOL=SOLUSDT
SHADOW_START_QUOTE=15
SHADOW_LATENCY_MS=150
MARKET_DATA_DIR=./data/market
# Optional worker cadences (ms): engine snapshot for boot restore, process-health input, status log.
# SNAPSHOT_EVERY_MS=60000
# HEALTH_EVERY_MS=5000
# STATUS_EVERY_MS=30000
# RUN_FOR_MS=0   # >0: graceful shutdown after this long (tests / proofs)

# --- MEXC (only needed for live, phase E8). Key bound to the VPS IP, trading pairs restricted.
MEXC_API_KEY=
MEXC_API_SECRET=

# --- Live (E8). The live process refuses to start unless EVERY item holds (live-gate.ts).
# LIVE_REPORT_FILE: official evaluator report with status GO (evaluate --out report.json).
# LIVE_SYMBOL: the best GO pair. LIVE_ACK: the exact line the evaluator prints for it.
# LIVE_KEY_ATTESTED: type "trade-only,no-withdraw,ip-bound" only after checking the key in the
#   MEXC UI (MEXC has no API to prove key permissions or IP binding).
# LIVE_PAPER_OFFSET_BPS: rollout step 1 — orders rest this far from the market (e.g. 500) and never fill.
LIVE_REPORT_FILE=
LIVE_SYMBOL=
LIVE_ACK=
LIVE_CAPITAL_QUOTE=15
LIVE_CAPITAL_MAX=15
LIVE_KEY_ATTESTED=
LIVE_PAPER_OFFSET_BPS=0

# --- Treasury withdrawals (E9). Read docs/runbooks/vps.md §6d first.
# The withdrawer is a SEPARATE process with its OWN key: withdraw permission only, bound to the
# VPS IP, and the treasury address added to the MEXC withdrawal address book. It never receives
# MEXC_API_KEY. WITHDRAW_ENABLED stays false everywhere else (the live gate refuses true).
# WITHDRAW_KEY_ATTESTED: type "withdraw-only,ip-bound,address-whitelisted" after checking in the UI.
# WITHDRAW_CHANNEL_SECRET: random, ≥ 32 chars, same value for live + withdrawer (openssl rand -hex 32).
# WITHDRAW_NETWORK: the exact MEXC network name of USDT on Solana (the withdrawer lists them if wrong).
# WITHDRAW_ADDRESS: your Solana treasury wallet (public address). Min ≥ 20, daily cap ≤ 1000.
MEXC_WITHDRAW_API_KEY=
MEXC_WITHDRAW_API_SECRET=
WITHDRAW_ENABLED=false
WITHDRAW_KEY_ATTESTED=
WITHDRAW_CHANNEL_SECRET=
WITHDRAW_COIN=USDT
WITHDRAW_NETWORK=
WITHDRAW_ADDRESS=
WITHDRAW_MIN=20
WITHDRAW_DAILY_CAP=100

# --- Sentinel (legacy scout + Discord)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_ALERT_CHANNEL_ID=
DISCORD_TRADING_CHANNEL_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
MIN_LIQUIDITY_USD=10000
MIN_VOLUME_USD_24H=25000
MAX_AGE_HOURS=72
POLL_INTERVAL_MS=30000

# ---- Operator API (apps/api, E5) — see docs/runbooks/vps.md §2b --------------------------------
# Exact dashboard origin (bare scheme://host[:port]); cookie writes must come from it.
API_ORIGIN=http://localhost:8080
# Allowlisted Phantom wallet address(es), comma-separated (public addresses, not secrets).
API_ALLOWED_WALLETS=
# base32 TOTP secret: generate with `npx tsx apps/api/src/provision.ts totp` (never commit it).
API_TOTP_SECRET=
# Scoped service tokens, hash only: name:sha256hex:read+pause (provision.ts service <name> <scopes>).
API_SERVICE_TOKENS=
API_COOKIE_SECURE=false

# --- Alerts (alerter process, E4/AFK) ---
# Discord: channel settings → Integrations → Webhooks → New webhook → copy URL. It is a secret.
ALERT_DISCORD_WEBHOOK=
# Second healthchecks.io check that watches the alerter itself (optional).
ALERTER_HEALTHCHECK_URL=
# Daily digest hour in UTC (11 = 08:00 in Brasília).
ALERT_DAILY_UTC_HOUR=11
