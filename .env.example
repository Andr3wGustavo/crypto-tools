# ==============================================================================
# UNIFIED CORTEX CRYPTO SENTINEL - CONFIGURATION TEMPLATE
# ==============================================================================

# Database (Prisma SQLite)
DATABASE_URL="file:./prisma/dev.db"

# ------------------------------------------------------------------------------
# 1. DISCORD CONFIGURATION
# ------------------------------------------------------------------------------
DISCORD_TOKEN="your_discord_bot_token_here"
DISCORD_CLIENT_ID="your_discord_client_id_here"
DISCORD_GUILD_ID="optional_guild_id_for_instant_slash_command_sync"
DISCORD_ALERT_CHANNEL_ID="channel_id_for_gem_and_radar_alerts"
DISCORD_TRADING_CHANNEL_ID="channel_id_for_market_making_and_pnl_logs"

# ------------------------------------------------------------------------------
# 2. AI CONFIGURATION (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-2.0-flash"

# ------------------------------------------------------------------------------
# 3. SCOUT & RADAR FILTERS (DEXSCREENER)
# ------------------------------------------------------------------------------
MIN_LIQUIDITY_USD=10000
MIN_VOLUME_USD_24H=25000
MAX_AGE_HOURS=72
POLL_INTERVAL_MS=30000

# ------------------------------------------------------------------------------
# 4. BINANCE SPOT AUTOMATION & MARKET MAKER
# ------------------------------------------------------------------------------
BINANCE_API_KEY="your_binance_api_key_here"
BINANCE_SECRET="your_binance_secret_key_here"
BINANCE_BASE_URL="https://api.binance.com"
BINANCE_WS_URL="wss://stream.binance.com:9443/ws"

# Market Making Strategy Parameters
MM_SYMBOL="BTCUSDT"
MM_MIN_ORDER_USD=15.0
MM_MAX_POSITION_USD=100.0
MM_SAFETY_MARGIN=0.0005        # 0.05% margin above fees
MM_ATR_MULTIPLIER=2.0          # k1 volatility multiplier
MM_IMBALANCE_MULTIPLIER=0.5    # k2 book depth multiplier
MM_SKEW_FACTOR=0.001           # Avellaneda-Stoikov inventory skew factor
MM_INVENTORY_TARGET=0.5        # 50% base / 50% quote target
MM_DAILY_STOP_LOSS=-0.015      # -1.5% Daily Hard Stop
MM_DRIFT_THRESHOLD=0.002       # 0.2% price move triggers instant order cancel
