{
  "name": "cortex-farm",
  "version": "3.0.0",
  "private": true,
  "description": "Cortex Farm: shadow-first market-making farm (MEXC maker-0% + Binance lead-lag), double-entry treasury, Web3 dashboard.",
  "license": "ISC",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/sentinel/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm test",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "infra:up": "docker compose -f infra/compose.yaml up -d",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "worker:dev": "tsx watch apps/worker/src/main.ts",
    "sentinel:dev": "tsx watch apps/sentinel/src/index.ts",
    "build:worker": "node scripts/build-worker.mjs",
    "docker:worker": "docker build -f infra/docker/worker.Dockerfile -t cortex-worker:dev .",
    "web:dev": "npm run dev -w @cortex/web",
    "web:build": "npm run build -w @cortex/web",
    "dev:dashboard": "tsx apps/api/src/dev/server.ts",
    "e2e": "npm run web:build && playwright test -c apps/web/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.28.2",
    "fast-check": "^3.23.2",
    "prisma": "5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
